<?xml version="1.0" encoding="utf-8"?>
<!--
  DDD Dropbox manifest (validated in Research/R5 §3).

  android-core's manifest is merged automatically and already supplies Wi-Fi/location/network
  permissions. We still declare everything the dropbox itself relies on, because:
   - FOREGROUND_SERVICE and WAKE_LOCK reach BundleTransport only transitively via work-runtime;
     startForeground() on targetSdk 34 and the keep-awake lock need them, so declare them explicitly.
   - The dropbox both HOSTS a Wi-Fi Direct group (like BundleTransport) and JOINS one via DNS-SD
     discovery (like BundleClient). On minSdk 33 both need only NEARBY_WIFI_DEVICES (neverForLocation),
     which is the only Wi-Fi permission requested at runtime; ACCESS_FINE_LOCATION is merged in from
     android-core anyway and kept declared here for parity, but never required.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi Direct: host (create group, advertise DNS-SD) and join (discover, connect). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Same flags as android-core's declaration so the manifest merger does not conflict. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- gRPC over the P2P link (OkHttp server on 7777 and channel to the carrier's 7777). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Always-on stationary relay: foreground data-sync service with optional keep-awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Unattended relay: restart the service after a reboot (BootReceiver, "Start on boot" setting). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Settings "Server keys (QR)": scanning the server's QR code (android-core QRScannerScreen). Optional: the
         same URL can be pasted, so a dropbox without a camera still installs and works. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.wifi.direct" android:required="true"/>

    <application
        android:name="net.discdd.crashreports.AcraApp"
        android:icon="@drawable/bundledropbox_icon"
        android:roundIcon="@drawable/bundledropbox_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <!-- dataSync is compliant at targetSdk 34. FUTURE (audit i8): at targetSdk 35+ dataSync is limited to
             6 h per 24 h and may not start from BOOT_COMPLETED; switch to connectedDevice
             (FOREGROUND_SERVICE_CONNECTED_DEVICE) before raising targetSdk. -->
        <service
            android:name="net.discdd.bundledropbox.service.DropboxService"
            android:enabled="true"
            android:foregroundServiceType="dataSync"
            android:exported="false"/>

        <!-- Starts DropboxService after boot and after an app update (Android does not restart a sticky
             service whose package was replaced) when "Start automatically" is on and the operator has not
             pressed Stop. Exported only so the system can deliver these broadcasts; it ignores every other
             action. No LOCKED_BOOT_COMPLETED: all dropbox state is in credential-encrypted storage. -->
        <receiver
            android:name="net.discdd.bundledropbox.service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- singleTop: the notification reopens the existing instance instead of stacking a second one. -->
        <activity
            android:name="net.discdd.bundledropbox.BundleDropboxActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
